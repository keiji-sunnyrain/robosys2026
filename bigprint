import sys
from letter_data import letter_data

def print_big(input,input_letter):
    """大きく表示(1行分)"""
    for i in range(7):
        for letter in input:
            print(letter_data[letter][i].replace("#", input_letter).replace(".", " "),end=" ")
        print()

merged = ""
print_data=[]
if sys.stdin.isatty():
    # 引数入力
    for word in sys.argv[1:]:
        merged+=word
        merged+=" "
    for line in merged.split("\n"):
        for i in range(0, len(line), 10):
            print_big(line[i:i+10], '@')
else:
    # 標準入力
    for line in sys.stdin:
        merged+=line
        merged+=" "
    for line in merged.split("\n"):
        for i in range(0, len(line), 10):
            print_big(line[i:i+10], '@')

print()